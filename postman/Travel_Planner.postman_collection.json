                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_id\": \"{{external_id}}\",\n  \"notes\": \"Imported from Art Institute API\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/places",
              "host": [
